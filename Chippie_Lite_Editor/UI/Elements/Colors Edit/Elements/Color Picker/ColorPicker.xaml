<UserControl x:Class="Chippie_Lite_WPF.UI.Elements.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D1D5DB">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,5,5"/>
                                <RectangleGeometry Rect="5,5,5,5"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="IsDirectionReversed" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFFF0000" Offset="0.00"/>
                                        <GradientStop Color="#FFFF00FF" Offset="0.17"/>
                                        <GradientStop Color="#FF0000FF" Offset="0.33"/>
                                        <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                        <GradientStop Color="#FF00FF00" Offset="0.67"/>
                                        <GradientStop Color="#FFFFFF00" Offset="0.83"/>
                                        <GradientStop Color="#FFFF0000" Offset="1.00"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="22" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Image Source="../../../../../Resources/Images/Icons/Circle.png" Width="12">
                                                    <Image.Effect>
                                                        <DropShadowEffect Opacity="0.2" ShadowDepth="1"/>
                                                    </Image.Effect>
                                                </Image>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" BorderBrush="{StaticResource 'Deep Purple'}" 
                        BorderThickness="4" ClipToBounds="True">
                    <Border BorderBrush="{StaticResource 'Dark Blue'}" 
                        BorderThickness="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="SvCanvas"
                                  Background="Transparent"
                                  MouseLeftButtonDown="SvCanvas_MouseDown"
                                  MouseMove="SvCanvas_MouseMove"
                                  MouseLeftButtonUp="SvCanvas_MouseUp"
                                  SizeChanged="SvCanvas_SizeChanged">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                            <GradientStop x:Name="HueStop" Color="#FFFF00FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Selector Ring -->
                                <Canvas IsHitTestVisible="False">
                                    <Image x:Name="SvThumb" Source="../../../../../Resources/Images/Icons/Circle.png" Width="12">
                                        <Image.Effect>
                                            <DropShadowEffect Opacity="0.2" ShadowDepth="1"/>
                                        </Image.Effect>
                                    </Image>
                                </Canvas>
                            </Grid>
                            <Slider x:Name="HueSlider" Grid.Row="1"
                                    Style="{StaticResource HueSliderStyle}"
                                    ValueChanged="HueSlider_ValueChanged"/>
                        </Grid>
                    </Border>
                </Border>
                        
            <Grid Grid.Row="1" Margin="0, 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="128"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border MinHeight="24"
                        BorderBrush="{StaticResource 'Deep Purple'}" 
                        BorderThickness="4" 
                        Background="{StaticResource CheckerboardBrush}">
                    <Border x:Name="PreviewFill"/>
                </Border>
                <Border Grid.Column="1"  BorderBrush="{StaticResource 'Deep Purple'}" 
                        BorderThickness="4" Margin="12,0,0,0">
                    <local:ConditionalTextbox x:Name="HexText"
                                              InvalidTextBrush="{StaticResource Red}"
                                              Condition="HexCodeCondition"
                                              TextConfirmed="HexText_OnTextConfirmed"/>
                </Border>
            </Grid>
                        
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="32"/>
                    <RowDefinition Height="*" MinHeight="32"/>
                    <RowDefinition Height="*" MinHeight="32"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="R" VerticalAlignment="Center"
                           FontSize="16"
                           FontFamily="{StaticResource TextFont}"
                           Foreground="{StaticResource White}"/>
                <Slider x:Name="RSlider" Grid.Row="0" Grid.Column="1" 
                        Style="{StaticResource ModernSliderStyle}"
                        Maximum="255" VerticalAlignment="Center" 
                        ValueChanged="RgbaSlider_ValueChanged"/>
                <Border Grid.Row="0" Grid.Column="2" Margin="12,4,0,0" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        BorderBrush="{StaticResource 'Deep Purple'}"
                        BorderThickness="4">
                    <local:ConditionalTextbox x:Name="RTextbox" Style="{StaticResource ConditionalTextbox.Default}"
                                              InvalidTextBrush="{StaticResource Red}"
                                              Condition="ColorByteCondition"
                                              TextConfirmed="RGBTextbox_OnTextConfirmed"/>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center"
                           FontSize="16"
                           FontFamily="{StaticResource TextFont}"
                           Foreground="{StaticResource White}"/>
                <Slider x:Name="GSlider" Grid.Row="1" Grid.Column="1" 
                        Style="{StaticResource ModernSliderStyle}"
                        Maximum="255" VerticalAlignment="Center" 
                        ValueChanged="RgbaSlider_ValueChanged"/>
                <Border Grid.Row="1" Grid.Column="2" Margin="12,4,0,0" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        BorderBrush="{StaticResource 'Deep Purple'}"
                        BorderThickness="4">
                    <local:ConditionalTextbox x:Name="GTextbox" Style="{StaticResource ConditionalTextbox.Default}"
                                              InvalidTextBrush="{StaticResource Red}"
                                              Condition="ColorByteCondition"
                                              TextConfirmed="RGBTextbox_OnTextConfirmed"/>
                </Border>
                

                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center"
                           FontSize="16"
                           FontFamily="{StaticResource TextFont}"
                           Foreground="{StaticResource White}"/>
                <Slider x:Name="BSlider" Grid.Row="2" Grid.Column="1" 
                        Style="{StaticResource ModernSliderStyle}"
                        Maximum="255" VerticalAlignment="Center" 
                        ValueChanged="RgbaSlider_ValueChanged"/>
                <Border Grid.Row="2" Grid.Column="2" Margin="12,4,0,0" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        BorderBrush="{StaticResource 'Deep Purple'}"
                        BorderThickness="4">
                    <local:ConditionalTextbox x:Name="BTextbox" Style="{StaticResource ConditionalTextbox.Default}"
                                              Condition="ColorByteCondition"
                                              TextConfirmed="RGBTextbox_OnTextConfirmed"
                                              InvalidTextBrush="{StaticResource Red}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>