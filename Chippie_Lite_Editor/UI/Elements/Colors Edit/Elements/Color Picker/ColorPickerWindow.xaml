<Window x:Class="Chippie_Lite_WPF.UI.Elements.ColorPickerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             WindowStyle="None"
             ResizeMode="CanResize"
             Background="{StaticResource 'Dark Blue'}"
             Width="350" Height="400"
             d:DesignHeight="400" d:DesignWidth="350"
             x:Name="Root">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <local:TitledFrame Style="{StaticResource Chippie.TitledFrame.Default}" Title="{Binding Title, ElementName=Root}">
        <local:TitledFrame.TopContent>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <local:WindowRibbon VisibleButtons="1"/>
            </Grid>
        </local:TitledFrame.TopContent>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <local:ColorPicker x:Name="PickerElement" Grid.Row="0"/>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                <local:SquareButton x:Name="OkBtn" Label="Ok" Margin="4"
                                       BackgroundDefaultColor="{StaticResource 'Deep Purple'}"
                                       BackgroundHoverColor="{StaticResource Red}"
                                       BackgroundClickColor="{StaticResource Pink}"
                                       Click="OkBtn_OnClick"/>
                        
                <local:SquareButton x:Name="CancelBtn" Label="Cancel" Margin="4"
                                       BackgroundDefaultColor="{StaticResource 'Deep Purple'}"
                                       BackgroundHoverColor="{StaticResource Red}"
                                       BackgroundClickColor="{StaticResource Pink}"
                                       Click="CancelBtn_OnClick"/>
            </StackPanel>
        </Grid>
    </local:TitledFrame>
</Window>
