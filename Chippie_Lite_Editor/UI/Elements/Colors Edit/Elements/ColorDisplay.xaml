<Border x:Class="Chippie_Lite_WPF.UI.Elements.ColorDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="128"
             BorderThickness="4"
             BorderBrush="{StaticResource 'Deep Purple'}">
    <Border BorderThickness="4" BorderBrush="{StaticResource 'Dark Blue'}">
        <Label x:Name="HexCodeLabel" Style="{StaticResource Chippie.Label.Default}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
</Border>
