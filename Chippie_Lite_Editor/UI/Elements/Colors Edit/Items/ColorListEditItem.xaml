<local:ColorsListItem x:Class="Chippie_Lite_WPF.UI.Elements.ColorListEditItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="512"
             MouseDown="ColorListEditItem_OnMouseDown" MouseUp="ColorListEditItem_OnMouseUp"
             MouseLeave="ColorListEditItem_OnMouseLeave" MouseDoubleClick="ColorListEditItem_OnMouseDoubleClick">
    <UserControl.Style>
        <Style TargetType="local:ColorListEditItem">
            <Setter Property="Background" Value="{StaticResource 'Dark Blue'}"/>
            
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="False"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{StaticResource 'Darkish Blue'}"/>
                </MultiTrigger>
                
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="True"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{StaticResource 'Darkisher Blue'}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    
    <Border BorderThickness="0, 0, 0, 4" BorderBrush="{StaticResource 'Deep Purple'}">
        <Grid Margin="4, 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="32"/>
                <ColumnDefinition Width="*" MinWidth="128"/>
                <ColumnDefinition Width="2*" MinWidth="128"/>
            </Grid.ColumnDefinitions>
        
            <Label x:Name="IndexLabel" Style="{StaticResource Chippie.Label.Default}"
                   VerticalAlignment="Stretch" Margin="4, 0"/>
        
            <local:ColorDisplay x:Name="ColorDisplay" Grid.Column="1"/>
        
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            
                <local:SquareButton x:Name="EditBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/edit.png"
                                    Click="EditBtn_OnClick"/>
                <local:SquareButton x:Name="DuplicateBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/Duplicate.png"
                                    Click="DuplicateBtn_OnClick"/>
                <local:SquareButton x:Name="DeleteBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/Trash.png"
                                    Click="DeleteBtn_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</local:ColorsListItem>
