<UserControl x:Class="Chippie_Lite_WPF.UI.Elements.ColorsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <elements:TitledFrame Style="{StaticResource Chippie.TitledFrame.Default}" Title="Colors">
            <elements:TitledFrame.TopContent>
                <Grid HorizontalAlignment="Right">
                    <elements:SquareButton x:Name="AddBtn" Margin="4" 
                                           Icon="../../../Resources/Images/Icons/plus.png"
                                           BackgroundDefaultColor="{StaticResource 'Deep Purple'}"
                                           BackgroundHoverColor="{StaticResource Red}"
                                           BackgroundClickColor="{StaticResource Pink}"
                                           Click="AddBtn_OnClick"/>
                </Grid>
            </elements:TitledFrame.TopContent>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource Chippie.ScrollViewer}">
                <StackPanel x:Name="ItemPanel" Orientation="Vertical"/>
            </ScrollViewer>
        </elements:TitledFrame>
    </Grid>
</UserControl>
