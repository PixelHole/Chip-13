<UserControl x:Class="Chippie_Lite_WPF.UI.Elements.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             Background=" Transparent"
             d:DesignHeight="300" d:DesignWidth="500"
             MinHeight="152" MinWidth="430">
    
    <elements:TitledFrame Style="{StaticResource Chippie.TitledFrame.Default}">
        <elements:TitledFrame.TopContent>
            <Grid Margin="4, 4">
                
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ComboBox x:Name="ModuleSelect" Style="{StaticResource Chippie.ComboBox}" SelectionChanged="ModuleSelect_OnSelectionChanged"/>
                    <Label x:Name="ModuleNameLabel" Style="{StaticResource Chippie.Label.Default}"/>
                    
                    <elements:SquareButton x:Name="PageDownBtn" Click="PageDownBtn_OnClick" Margin="32, 0, 0, 0"
                                           Icon="/Resources/Images/Icons/ThumbLeft.png"
                                           BackgroundHoverColor="{StaticResource Red}"
                                           BackgroundClickColor="{StaticResource Pink}"/>
                
                    <elements:ConditionalTextbox x:Name="PageIndexBox" MinWidth="32"
                                                 Style="{StaticResource ConditionalTextbox.Default}"
                                                 ValidTextBrush="{StaticResource White}"
                                                 InvalidTextBrush="{StaticResource Red}"
                                                 RetainText="True"
                                                 Condition="PageIndexCondition"
                                                 LostFocus="PageIndexBox_OnLostFocus"
                                                 KeyDown="PageIndexBox_OnKeyDown"
                                                 TextConfirmed="PageIndexBox_OnTextConfirmed"/>
                
                    <TextBlock x:Name="PageCountBlock" Text=" / 00"
                               FontSize="18" FontFamily="{StaticResource TextFont}"
                               Background="Transparent"
                               Foreground="{StaticResource White}"/>
                
                    <elements:SquareButton x:Name="PageUpBtn" Click="PageUpBtn_OnClick"
                                           Icon="/Resources/Images/Icons/ThumbRight.png"
                                           BackgroundHoverColor="{StaticResource Red}"
                                           BackgroundClickColor="{StaticResource Pink}"/>
                </StackPanel>
        
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                
                    <elements:ConditionalTextbox x:Name="SearchBox" MinWidth="160" 
                                                 Style="{StaticResource ConditionalTextbox.Default}"
                                                 Condition="SearchboxCondition"/>
                
                    <elements:SquareButton x:Name="SearchBtn" Click="SearchBtn_OnClick"
                                           Icon="/Resources/Images/Icons/MagnifyingGlass.png"
                                           BackgroundHoverColor="{StaticResource Red}"
                                           BackgroundClickColor="{StaticResource Pink}"/>
                </StackPanel>
            </Grid>
        </elements:TitledFrame.TopContent>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                    
                <Grid Margin="0, 0, 16, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                        
                    <Border Grid.Column="0" BorderBrush="{StaticResource 'Deep Purple'}" BorderThickness="0, 0, 4, 4"/>
                    
                    <Grid Grid.Column="1" x:Name="OffsetLabelGrid" />
                        
                </Grid>
                    
                <ScrollViewer x:Name="CellGridViewer" Grid.Row="1" Style="{StaticResource Chippie.ScrollViewer}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                            
                        <Grid x:Name="AddressLabelGrid" Grid.Column="0"/>
                            
                        <Grid Grid.Column="1" x:Name="CellGrid" SizeChanged="CellGrid_OnSizeChanged"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </elements:TitledFrame>
</UserControl>