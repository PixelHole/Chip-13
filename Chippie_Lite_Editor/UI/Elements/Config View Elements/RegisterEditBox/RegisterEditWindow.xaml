<Window x:Class="Chippie_Lite_WPF.UI.Elements.Config_View_Elements.RegisterEditBox.RegisterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements.Config_View_Elements.RegisterEditBox"
        xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Background="{StaticResource 'Dark Blue'}"
        Title="RegisterEditWindow" 
        Width="720" Height="200">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        <Border BorderThickness="2" BorderBrush="{StaticResource 'Dark Blue'}">
            <elements:TitledFrame Title="Edit Register" Style="{StaticResource Chippie.TitledFrame.Default}">
            <elements:TitledFrame.TopContent>
                <Grid HorizontalAlignment="Right" Margin="0">
                    <elements:SquareButton Icon="../../../../Resources/Images/Icons/strike_invert.png"
                                           BackgroundDefaultColor="Transparent"
                                           BackgroundHoverColor="{StaticResource Red}"
                                           BackgroundClickColor="{StaticResource Pink}"
                                           Click="SquareButton_OnClick"/>
                </Grid>
            </elements:TitledFrame.TopContent>
            <Grid Margin="4, 8, 4, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
        
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
            
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
            
                        <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}"  Content="Name"/>
            
                        <Border Grid.Column="1" Style="{StaticResource Chippie.Border.Default}" Margin="4">
                            <elements:ConditionalTextbox x:Name="NameBox" Style="{StaticResource ConditionalTextbox.Default}"
                                                         FontSize="18"
                                                         ValidTextBrush="{StaticResource White}"
                                                         InvalidTextBrush="{StaticResource Red}"
                                                         RetainText="False"
                                                         Condition="NameBoxCondition"/>
                        </Border>
            
                    </Grid>
            
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                
                        <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}" Content="ID"/>
                        <Border Grid.Column="1" Style="{StaticResource Chippie.Border.Default}" Margin="4">
                            <elements:ConditionalTextbox x:Name="IdBox" Style="{StaticResource ConditionalTextbox.Default}"
                                                         FontSize="18"
                                                         ValidTextBrush="{StaticResource White}"
                                                         InvalidTextBrush="{StaticResource Red}"
                                                         RetainText="False" Condition="IdBoxCondition"/>
                        </Border>
                
                    </Grid>
            
                </Grid>
        
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
            
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                
                        <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}"  Content="Value"/>
            
                        <Border Grid.Column="1" Style="{StaticResource Chippie.Border.Default}" Margin="4">
                            <elements:ConditionalTextbox x:Name="ValueBox" Style="{StaticResource ConditionalTextbox.Default}"
                                                         FontSize="18"
                                                         ValidTextBrush="{StaticResource White}"
                                                         InvalidTextBrush="{StaticResource Red}"
                                                         RetainText="False" Condition="NumberBoxCondition"/>
                        </Border>
                
                    </Grid>
            
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                
                        <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}"  Content="Length"/>
            
                        <Border Grid.Column="1" Style="{StaticResource Chippie.Border.Default}" Margin="4">
                            <elements:ConditionalTextbox x:Name="LengthLimitBox"  Style="{StaticResource ConditionalTextbox.Default}"
                                                         FontSize="18"
                                                         ValidTextBrush="{StaticResource White}"
                                                         InvalidTextBrush="{StaticResource Red}"
                                                         RetainText="False" Condition="NumberBoxCondition"/>
                        </Border>
                
                    </Grid>
            
                </Grid>
                
                <Grid Grid.Row="2">
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="4">
                        <elements:SquareButton x:Name="OkBtn" Label="Ok" Margin="4"
                                               BackgroundDefaultColor="{StaticResource 'Deep Purple'}"
                                               BackgroundHoverColor="{StaticResource Red}"
                                               BackgroundClickColor="{StaticResource Pink}"
                                               Click="OkBtn_OnClick"/>
                        
                        <elements:SquareButton x:Name="CancelBtn" Label="Cancel" Margin="4"
                                               BackgroundDefaultColor="{StaticResource 'Deep Purple'}"
                                               BackgroundHoverColor="{StaticResource Red}"
                                               BackgroundClickColor="{StaticResource Pink}"
                                               Click="CancelBtn_OnClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </elements:TitledFrame>
        </Border>
    </Grid>
</Window>