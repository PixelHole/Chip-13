<elements:RegisterListItem x:Class="Chippie_Lite_WPF.UI.Elements.RegisterListDisplayItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="256">
    <UserControl.Style>
        <Style TargetType="elements:RegisterListDisplayItem">
            <Setter Property="Background" Value="{Binding DefaultColor, RelativeSource={RelativeSource Self}}"/>
            
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="False"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{Binding HoverColor, RelativeSource={RelativeSource Self}}"/>
                </MultiTrigger>
                
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="True"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{Binding ClickColor, RelativeSource={RelativeSource Self}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    
    <Border BorderThickness="0, 0, 0, 4" BorderBrush="{StaticResource 'Deep Purple'}">
        <Grid Name="Body" MouseDown="Body_OnMouseDown" MouseUp="Body_OnMouseUp"
              Background="Transparent" IsHitTestVisible="True">
        
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        
            <Label x:Name="IdLabel" Grid.Column="0" FontFamily="{StaticResource TextFont}" FontSize="16"
                   Foreground="{StaticResource White}" Background="Transparent" IsEnabled="False" 
                   HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
        
            <TextBlock x:Name="ContentLabel" Grid.Column="1" FontFamily="{StaticResource TextFont}" FontSize="16"
                       Foreground="{StaticResource White}" Background="Transparent" IsEnabled="False" 
                       VerticalAlignment="Center" HorizontalAlignment="Left" 
                       TextWrapping="Wrap"/>
        
        </Grid>
    </Border>
</elements:RegisterListItem>
