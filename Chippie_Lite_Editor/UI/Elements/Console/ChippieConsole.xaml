<UserControl x:Class="Chippie_Lite_WPF.UI.Elements.Console.ChippieConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Elements.Console"
             xmlns:consoleControlLibrary="clr-namespace:ConsoleControlLibrary"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <elements:TitledFrame Title="Console" Style="{StaticResource Chippie.TitledFrame.Default}">
            <consoleControlLibrary:ConsoleView/>
        </elements:TitledFrame>
    </Grid>
</UserControl>
