<UserControl x:Class="Chippie_Lite_WPF.UI.Windows.Development.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             xmlns:development="clr-namespace:Chippie_Lite_WPF.UI.Windows.Development"
             xmlns:consoleControlLibrary="clr-namespace:ConsoleControlLibrary"
             xmlns:console="clr-namespace:Chippie_Lite_WPF.UI.Elements.Console"
             mc:Ignorable="d"
             Background="Transparent"
             SnapsToDevicePixels="True"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="32"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="1" Background="{StaticResource 'Deep Purple'}">
            
            <elements:ToggleButton x:Name="ToggleInstructionBtn" OnSelected="ToggleInstructionBtn_OnOnSelected"
                                   Icon="../../../Resources/Images/Icons/BigI.png" Label="" ToolTip="Toggle Instructions"
                                   UnselectedHoverColor="{StaticResource Red}" 
                                   UnselectedClickColor="{StaticResource Pink}"
                                   SelectedDefaultColor="{StaticResource Red}"
                                   SelectedHoverColor="{StaticResource Pink}"
                                   SelectedClickColor="{StaticResource Bisque}"
                                   Selected="True"/>
            
            <elements:ToggleButton x:Name="ToggleMemoryBtn" OnSelected="ToggleMemoryBtn_OnOnSelected"
                                   Icon="../../../Resources/Images/Icons/boxes.png" Label="" ToolTip="Toggle Memory"
                                   UnselectedHoverColor="{StaticResource Red}" 
                                   UnselectedClickColor="{StaticResource Pink}"
                                   SelectedDefaultColor="{StaticResource Red}"
                                   SelectedHoverColor="{StaticResource Pink}"
                                   SelectedClickColor="{StaticResource Bisque}"
                                   Selected="True"/>
            
            <elements:ToggleButton x:Name="ToggleRegistersBtn" OnSelected="ToggleRegistersBtn_OnOnSelected"
                                   Icon="../../../Resources/Images/Icons/threeLinesThick.png" ToolTip="Toggle Registers"
                                   UnselectedHoverColor="{StaticResource Red}" 
                                   UnselectedClickColor="{StaticResource Pink}"
                                   SelectedDefaultColor="{StaticResource Red}"
                                   SelectedHoverColor="{StaticResource Pink}"
                                   SelectedClickColor="{StaticResource Bisque}"
                                   Selected="True"/>
        </StackPanel>
        
        <Grid x:Name="RowGrid" Grid.Column="0" Margin="0, 4, 4, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="4"/>
                <RowDefinition MinHeight="175" MaxHeight="300"/>
            </Grid.RowDefinitions>
            
            <Grid x:Name="ColumnGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="300" MinWidth="150"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition MaxWidth="300" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                
                <elements:InstructionDisplayList x:Name="InstructionDisplayList" Grid.Column="0"/>
                
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                
                <console:ChippieConsole Grid.Column="2"/>
                
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>
                
                <elements:RegisterList Grid.Column="4" x:Name="RegisterList" Mode="View"/>
                
            </Grid>
            
            <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent"/>
            
            <elements:MemoryView Grid.Row="2" Mode="View"/>
            
        </Grid>
        
    </Grid>
</UserControl>
