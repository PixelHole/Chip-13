<UserControl x:Class="Chippie_Lite_WPF.UI.Config.IOEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <elements:TitledFrame Title="IO Details" Style="{StaticResource Chippie.TitledFrame.Default}">
        <Grid VerticalAlignment="Top" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="42"/>
                <RowDefinition MinHeight="42"/>
            </Grid.RowDefinitions>
        
            <Label Grid.Row="0" Grid.Column="0" Margin="0, 0, 0, 4" 
                   Style="{StaticResource Chippie.Label.Default}" Content="Width in Cells"/>
            
            <Border Grid.Row="0" Grid.Column="1" Margin="0, 0, 0, 4" 
                    BorderThickness="4" BorderBrush="{StaticResource 'Deep Purple'}">
                <elements:ConditionalTextbox x:Name="WidthBox" Condition="NumberCondition" TextConfirmed="WidthBox_OnTextConfirmed"
                                             ValidTextBrush="{StaticResource White}"
                                             InvalidTextBrush="{StaticResource Red}"
                                             Style="{StaticResource ConditionalTextbox.Default}"
                                             FontSize="18"/>
            </Border>
            
            <Label Grid.Row="1" Grid.Column="0" 
                   Style="{StaticResource Chippie.Label.Default}" Content="Height in Cells"/>
            <Border Grid.Row="1" Grid.Column="1"
                    BorderThickness="4" BorderBrush="{StaticResource 'Deep Purple'}">
                <elements:ConditionalTextbox x:Name="HeightBox" Condition="NumberCondition" TextConfirmed="HeightBox_OnTextConfirmed"
                                             ValidTextBrush="{StaticResource White}"
                                             InvalidTextBrush="{StaticResource Red}"
                                             Style="{StaticResource ConditionalTextbox.Default}"
                                             FontSize="18"/>
            </Border>
            
        </Grid>
    </elements:TitledFrame>
</UserControl>
