<UserControl x:Class="Chippie_Lite_WPF.UI.Config.MemoryProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <elements:TitledFrame x:Name="MemoryConfig" Title="Memory Config" Style="{StaticResource Chippie.TitledFrame.Default}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0, 0, 0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}" Content="Name"/>
                        <Border Grid.Column="1" MinHeight="32" 
                                BorderThickness="4" BorderBrush="{StaticResource 'Deep Purple'}">
                            <elements:ConditionalTextbox x:Name="NameBox" Condition="NameCondition"
                                                         Style="{StaticResource ConditionalTextbox.Default}"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0, 0, 0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}" Content="Size"/>
                            <Border Grid.Column="1" MinHeight="32"
                                    BorderThickness="4" BorderBrush="{StaticResource 'Deep Purple'}">
                                <elements:ConditionalTextbox x:Name="SizeBox" Condition="SizeCondition"
                                                             Style="{StaticResource ConditionalTextbox.Default}"/>
                            </Border>
                        </Grid>
                        
                        <Grid Grid.Column="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Label Grid.Column="0" Style="{StaticResource Chippie.Label.Default}" Content="Word Length"/>
                            <Border Grid.Column="1" MinHeight="32" 
                                    BorderThickness="4" BorderBrush="{StaticResource 'Deep Purple'}">
                                <elements:ConditionalTextbox x:Name="WordLengthBox" Condition="WordLengthCondition"
                                                             Style="{StaticResource ConditionalTextbox.Default}"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0, 0, 0, 4">
                        <Label Style="{StaticResource Chippie.Label.Default}" Content="Attributes : "/>
                        <elements:ToggleButton x:Name="PermanentToggle" Label="Permanent" Margin="4, 0, 0, 0"/>
                        <elements:ToggleButton x:Name="ReadOnlyToggle" Label="Read Only" Margin="4, 0, 0, 0"/>
                    </StackPanel>
                    
                </Grid>
                
                <elements:MemoryView x:Name="MemoryView" Grid.Row="1"/>
            </Grid>
        </elements:TitledFrame>
    </Grid>
</UserControl>