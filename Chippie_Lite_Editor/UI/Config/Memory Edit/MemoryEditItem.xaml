<UserControl x:Class="Chippie_Lite_WPF.UI.Config.MemoryEditItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="300"
             MouseDown="MemoryEditItem_OnMouseDown" MouseUp="MemoryEditItem_OnMouseUp" 
             MouseLeave="MemoryEditItem_OnMouseLeave" MouseDoubleClick="MemoryEditItem_OnMouseDoubleClick">
    <UserControl.Style>
        <Style TargetType="local:MemoryEditItem">
            <Setter Property="Background" Value="{StaticResource 'Dark Blue'}"/>
            
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="False"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{StaticResource 'Darkish Blue'}"/>
                </MultiTrigger>
                
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsPressed" Value="True"/>
                    </MultiTrigger.Conditions>
                    
                    <Setter Property="Background" Value="{StaticResource 'Darkisher Blue'}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    
    <Border BorderBrush="{StaticResource 'Deep Purple'}" BorderThickness="0, 0, 0, 4">
        <Grid Margin="4, 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="NameLabel" Grid.Column="0" Style="{StaticResource Chippie.Label.Default}" 
                       FontSize="22" VerticalAlignment="Center" FontFamily="{StaticResource TextFontAlt}"/>
                <Label x:Name="SizeLabel" Grid.Column="1" Style="{StaticResource Chippie.Label.Default}" 
                       IsEnabled="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Label x:Name="WordLengthLabel" Grid.Column="2" Style="{StaticResource Chippie.Label.Default}" 
                       IsEnabled="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Label x:Name="ByteSizeLabel" Grid.Column="3" Style="{StaticResource Chippie.Label.Default}" 
                       IsEnabled="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel x:Name="AttributesPanel" Grid.Column="4"  Orientation="Vertical" Margin="0, 4"/>
            </Grid>
        
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="16, 0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Hidden"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            
                <elements:SquareButton x:Name="EditBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/edit.png"
                                       Click="EditBtn_OnClick"/>
                <elements:SquareButton x:Name="DuplicateBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/Duplicate.png"
                                       Click="DuplicateBtn_OnClick"/>
                <elements:SquareButton x:Name="DeleteBtn" Width="26" Height="26" Icon="../../../../Resources/Images/Icons/Trash.png"
                                       Click="DeleteBtn_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>