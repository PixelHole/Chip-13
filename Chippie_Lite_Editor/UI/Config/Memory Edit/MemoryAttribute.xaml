<UserControl x:Class="Chippie_Lite_WPF.UI.Config.MemoryAttribute"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="32" d:DesignWidth="128">
    <StackPanel Orientation="Horizontal">
        <Label Style="{StaticResource Chippie.Label.Default}" Content="O"/>
        <Label Content="{Binding Attribute, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Margin="4" Style="{StaticResource Chippie.Label.Default}"/>
    </StackPanel>
</UserControl>
