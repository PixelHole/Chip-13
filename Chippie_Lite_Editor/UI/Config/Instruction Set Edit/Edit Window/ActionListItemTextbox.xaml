<UserControl x:Class="Chippie_Lite_WPF.UI.Config.Edit_Window.ActionListItemTextbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Config.Edit_Window"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border BorderBrush="{StaticResource 'Deep Purple'}" BorderThickness="4">
        <elements:ConditionalTextbox x:Name="Textbox" Style="{StaticResource ConditionalTextbox.Default}"
                            Condition="Condition"
                            TextConfirmed="Textbox_OnTextConfirmed"
                            InvalidTextBrush="{StaticResource Red}"
                            ValidTextBrush="{StaticResource White}"/>
    </Border>
</UserControl>
