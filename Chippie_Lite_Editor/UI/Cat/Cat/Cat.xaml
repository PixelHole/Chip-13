<!-- ReSharper disable once Xaml.RedundantAttachedProperty -->
<UserControl x:Class="Chippie_Lite_WPF.UI.Cat.Cat.Cat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Cat"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Wpf"
             mc:Ignorable="d"
             Background=" Transparent"
             Canvas.Bottom="0">
    <StackPanel>
        <Label x:Name="Label" Foreground="{StaticResource White}" FontSize="16" FontFamily="{StaticResource TextFont}" 
               VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
               Content="Name"/>
        <Image x:Name="Sprite" anim:ImageBehavior.AnimatedSource="../../../Resources/Images/Cat/sit idle.gif" 
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </StackPanel>
</UserControl>
