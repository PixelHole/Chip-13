<UserControl x:Class="Chippie_Lite_WPF.UI.Cat.Cat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chippie_Lite_WPF.UI.Cat"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Wpf"
             mc:Ignorable="d"
             Background=" Transparent"
             d:DesignHeight="64" d:DesignWidth="64">
    <Grid>
        <Image x:Name="Sprite" anim:ImageBehavior.AnimatedSource="../../../Resources/Images/Cat/sit idle.gif" 
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </Grid>
</UserControl>
