<Application x:Class="Chippie_Lite_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:elements="clr-namespace:Chippie_Lite_WPF.UI.Elements"
             mc:Ignorable="d"
             StartupUri="/UI/Windows/Main/MainWindow.xaml"
             Startup="App_OnStartup"
             Exit="App_OnExit">
    <Application.Resources>
        <FontFamily x:Key="TextFont">/Resources/Fonts/#Kenney Mini Regular</FontFamily>
        <FontFamily x:Key="TextFontAlt">/Resources/Fonts/#Kenney Mini Square Regular</FontFamily>
        <FontFamily x:Key="PixelCode">/Resources/Fonts/#Pixel Code</FontFamily>
        <FontFamily x:Key="Departure">/Resources/Fonts/#Departure Mono Regular</FontFamily>
        <FontFamily x:Key="Monogram">/Resources/Fonts/#monogram</FontFamily>
        <FontFamily x:Key="PublicPixel">/Resources/Fonts/#Public Pixel</FontFamily>
        <Brush x:Key="Black">#000000</Brush>
        <Brush x:Key="Dark Blue">#1d2b53</Brush>
        <Brush x:Key="Darkish Blue">#233361</Brush>
        <Brush x:Key="Darkisher Blue">#324478</Brush>
        <Brush x:Key="Deep Purple">#7e2553</Brush>
        <Brush x:Key="Dark Green">#008751</Brush>
        <Brush x:Key="Brown">#ab5236</Brush>
        <Brush x:Key="Weird Grey">#5f574f</Brush>
        <Brush x:Key="Light Grey">#c2c3c7</Brush>
        <Brush x:Key="White">#fff1e8</Brush>
        <Brush x:Key="Red">#ff004d</Brush>
        <Brush x:Key="Orange">#ffa300</Brush>
        <Brush x:Key="Yellow">#ffec27</Brush>
        <Brush x:Key="Green">#00e436</Brush>
        <Brush x:Key="Light Blue">#29adff</Brush>
        <Brush x:Key="Faded Purple">#83769c</Brush>
        <Brush x:Key="Pink">#ff77a8</Brush>
        <Brush x:Key="Bisque">#ffccaa</Brush>
        <ImageSource x:Key="LogoWhiteBig">Resources/Images/Logos/logo32.png</ImageSource>
        <ImageSource x:Key="LogoWhiteMed">Resources\Images\Logos\logo16.png</ImageSource>
        <ImageSource x:Key="LogoWhiteSml">Resources\Images\Logos\logo8.png</ImageSource>
        
        <ImageSource x:Key="ThumbUpIcon" >Resources/Images/Icons/ThumbUp.png</ImageSource>
        <ImageSource x:Key="ThumbDownIcon">Resources/Images/Icons/ThumbDown.png</ImageSource>
        
        <ImageSource x:Key="FolderIcon">Resources/Images/Icons/file2.png</ImageSource>
        <ImageSource x:Key="FileIcon">Resources/Images/Icons/File.png</ImageSource>

        <Style x:Key="Chippie.ScrollBarUpBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Name="Border" Margin="0" Background="{StaticResource 'Faded Purple'}">
                            <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource ThumbUpIcon}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{StaticResource Pink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground"
                                        Value="{StaticResource 'Light Grey'}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="Chippie.ScrollBarDownBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Name="Border" Margin="0" Background="{StaticResource 'Faded Purple'}">
                            <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource ThumbDownIcon}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{StaticResource Pink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground"
                                        Value="{StaticResource 'Light Grey'}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="Chippie.ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="{StaticResource Pink}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="Chippie.VerticalScrollBar"
                         TargetType="{x:Type ScrollBar}">
            <Grid Background="{StaticResource 'Faded Purple'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="0.00001*"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>
                
                <RepeatButton Grid.Row="0" Style="{StaticResource Chippie.ScrollBarUpBtn}" Height="16" Width="16"
                              Command="ScrollBar.LineUpCommand" Content="M 0 4 L 8 4 L 4 0 Z" />
                
                <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="true">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Chippie.ScrollBarThumb}" Margin="0"
                               Background="{StaticResource 'Faded Purple'}" BorderBrush="Transparent" />
                    </Track.Thumb>
                </Track>
                
                <RepeatButton Grid.Row="2" Style="{StaticResource Chippie.ScrollBarDownBtn}" Height="16" Width="16"
                              Command="ScrollBar.LineDownCommand" Content="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
        </ControlTemplate>
        
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template"
                            Value="{StaticResource Chippie.VerticalScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="Chippie.ScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"/>

                            <ScrollBar Grid.Column="1" Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <ControlTemplate x:Key="Chippie.ToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
                <Grid HorizontalAlignment="Right" Width="32">
                    <!-- Dropdown Chevron Arrow -->
                    <Label x:Name="Arrow"
                           Content="△"
                           FontSize="16"
                           FontFamily="{StaticResource PixelCode}"
                           Foreground="{StaticResource White}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="{StaticResource Red}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="{StaticResource Pink}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Chippie.ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource 'Deep Purple'}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Red}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chippie.ComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFontAlt}"/>
            <Setter Property="Padding" Value="10,0,32,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Chippie.ComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Clickable Toggle Button (Arrow & Box) -->
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource Chippie.ToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"/>

                            <!-- Displayed Selected Text Content -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- Popup Dropdown Container -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Top"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderBrush="{StaticResource 'Deep Purple'}"
                                        BorderThickness="4, 4, 4, 0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource 'Dark Blue'}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="Chippie.ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource 'Deep Purple'}"/>
                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                            </Trigger>

                            <!-- Selected state -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Red}"/>
                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                            </Trigger>

                            <!-- Selected + Hover state -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Red}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chippie.ListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Chippie.ListBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="{x:Type elements:TitledFrame}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type elements:TitledFrame}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        
                            <Grid Grid.Row="0" Background="{TemplateBinding BorderBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Title}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{StaticResource TextFontAlt}"
                                           VerticalAlignment="Center"
                                           Margin="4, 0"/>
                                
                                <Grid Grid.Column="1">
                                    <ContentPresenter ContentSource="TopContent" WindowChrome.IsHitTestVisibleInChrome="True" 
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                                
                            </Grid>
                        
                            <Border Grid.Row="1"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">

                                <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chippie.TitledFrame.Default"
               TargetType="{x:Type elements:TitledFrame}"
               BasedOn="{StaticResource {x:Type elements:TitledFrame}}">

            <Setter Property="BorderBrush"
                    Value="{StaticResource 'Deep Purple'}"/>

            <Setter Property="BorderThickness"
                    Value="4,0,4,4"/>

            <Setter Property="Foreground"
                    Value="{StaticResource White}"/>

            <Setter Property="FontSize"
                    Value="20"/>
        </Style>
        <Style x:Key="Chippie.Label.Default"
               TargetType="{x:Type Label}">
            
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chippie.Border.Default" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource 'Deep Purple'}"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        
        <Style x:Key="ConditionalTextbox.Default" TargetType="{x:Type elements:ConditionalTextbox}">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        
        <!-- Transparent clickable track hit-area -->
        <Style x:Key="SliderTransparentTrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" Height="20"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumb Style (Circular with Hover/Drag Animation) -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            
                            <Image Source="../../../../Resources/Images/Icons/Circle filled.png">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="Black"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main Modern Slider Style -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="{StaticResource White}"/> <!-- Unfilled track -->
            <Setter Property="Foreground" Value="{StaticResource Red}"/> <!-- Active fill & thumb -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Unfilled Track Background -->
                            <Border Height="8"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center"/>

                            <!-- Track & Thumb -->
                            <Track x:Name="PART_Track">
                                <!-- Filled Left Portion -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="8"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <!-- Unfilled Right Hit Area -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource SliderTransparentTrackButton}"/>
                                </Track.IncreaseRepeatButton>

                                <!-- Draggable Thumb -->
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"
                                           Foreground="{TemplateBinding Foreground}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>